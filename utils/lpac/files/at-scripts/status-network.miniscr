send "AT\r"
expect {
  "OK" break
  "ERROR" goto fail
}

send "AT+CREG?\r"
expect {
  "OK" goto done
  "ERROR" goto fail
}

send "AT+COPS?\r"
expect {
  "OK" goto done
  "ERROR" goto fail
}

send "AT+CSQ\r"
expect {
  "OK" goto done
  "ERROR" goto fail
}

fail:
print "Command failed.\n"
exit 1

done:
print "Done.\n"
exit 0
