send "AT\r"
expect {
  "OK"    print "AT: OK\n"
  "ERROR" print "AT: ERROR\n"
}

send "AT+CREG?\r"
expect {
  "OK"    print "AT+CREG?: OK\n"
  "ERROR" print "AT+CREG?: ERROR\n"
}

send "AT+COPS?\r"
expect {
  "OK"    print "AT+COPS?: OK\n"
  "ERROR" print "AT+COPS?: ERROR\n"
}

send "AT+CSQ\r"
expect {
  "OK"    print "AT+CSQ: OK\n"
  "ERROR" print "AT+CSQ: ERROR\n"
}

print "Done.\n"
exit 0
